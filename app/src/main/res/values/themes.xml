<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Прод-тема Material 3, без «dev»-акцентов -->
    <style name="Theme.NoteMap" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/plna_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/plna_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/plna_text</item>
        <item name="colorSecondary">@color/plna_accent_soft</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/plna_surface_elevated</item>
        <item name="colorOnSecondaryContainer">@color/plna_text</item>
        <item name="colorTertiary">@color/plna_accent</item>
        <item name="colorSurface">@color/plna_surface</item>
        <item name="colorOnSurface">@color/plna_text</item>
        <item name="colorOnSurfaceVariant">@color/plna_text_secondary</item>
        <item name="colorOutline">@color/plna_stroke</item>
        <item name="android:statusBarColor">@color/plna_bg</item>
        <item name="android:navigationBarColor">@color/plna_bg</item>
        <item name="android:windowBackground">@color/plna_bg</item>
        <item name="android:colorBackground">@color/plna_bg</item>
        <item name="colorError">@color/plna_danger</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.NoteMap.Splash" parent="Theme.NoteMap">
        <item name="android:windowBackground">@color/plna_splash_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Plna.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/plna_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Plna.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/plna_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Plna.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/plna_text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Plna.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>
