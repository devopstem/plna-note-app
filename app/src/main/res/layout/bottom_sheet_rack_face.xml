<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/rack_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textAppearance="@style/Plna.Title"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/rack_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/plna_text_secondary"
        android:textSize="13sp" />

    <by.smartplanogram.plnanote.ui.map.RackFaceView
        android:id="@+id/rack_face"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/rack_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/rack_face_hint"
        android:textColor="@color/plna_text_muted"
        android:textSize="12sp" />
</LinearLayout>
